<odoo>
    <template id="reporte_pendientes_equipo_template">
        <t t-call="web.html_container">
            <t t-foreach="data" t-as="linea">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        <div class="row">
                            <div class="col-md-12">
                                <h2>Informe de Deudas Pendientes por Equipo de Ventas</h2>
                                <p>Generado el: <span t-esc="fields.Date.today()"/></p>
                                <table class="table table-condensed table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Equipo de Ventas</th>
                                            <th class="text-right">Total Pendiente</th>
                                            <th class="text-right">Factura mÃ¡s Antigua del Equipo</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="data" t-as="linea">
                                            <td>
                                                <span t-field="linea['team_id']" 
                                                      t-field-options='{"widget": "many2one", "display": "display_name"}'/>
                                            </td>
                                            <td class="text-right">
                                                <span t-esc="'{0:,.2f}'.format(linea['total_pendiente'])"/>
                                            </td>
                                            <td class="text-right">
                                                <span t-esc="linea['fecha_factura_antigua'] or ''"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th><strong>Totales Generales</strong></th>
                                            <th class="text-right">
                                                <strong>
                                                    <t t-esc="'{0:,.2f}'.format(total_general)"/>
                                                </strong>
                                            </th>
                                            <th></th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <report id="action_reporte_pendientes_equipo"
            model="informe.pendientes.equipo"
            string="Pendientes por Equipo"
            report_type="qweb-pdf"
            name="asi_gestion_cxc.reporte_pendientes_equipo_template"
            file="asi_gestion_cxc.reporte_pendientes_equipo_template"
            print_report_name="'Pendientes por Equipo - %s' % (fields.Date.today())"/>
</odoo>
